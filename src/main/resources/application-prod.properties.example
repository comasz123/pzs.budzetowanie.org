# Wzorzec produkcyjny dla noble.
# Działająca konfiguracja leży obok JAR-a:
#   /var/www/pzs.budzetowanie.org/application.properties
# Jednostka systemd nie ustawia spring.profiles.active — ten plik nie jest ładowany sam.

server.address=127.0.0.1
server.port=8081
server.forward-headers-strategy=native

app.security.require-auth=true
app.security.require-https=true
app.seed.overwrite-existing=false
app.seed.demo-data=false

server.servlet.session.cookie.secure=true
server.servlet.session.cookie.same-site=lax

app.tenant.demo-host=pzs.budzetowanie.org
app.tenant.localhost-as-demo=false

app.org.code=pzs
app.org.name=PZS
app.org.legal-name=PZS

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false

app.budget.clear-2025-on-startup=false
app.budget.clear-2026-on-startup=false
app.budget.allow-destructive-clear=false

app.admin.email=admin@example.com
app.admin.password=CHANGE_ME
app.admin.first-name=Admin
app.admin.last-name=User

# Konto edycji. Puste hasło nie tworzy konta i nie zmienia istniejącego hasła.
# Konto z samą starą rolą ROLE_USER dostaje przy starcie rolę edit.
app.editor.email=katarzynadaliga@zielonasiec.pl
app.editor.password=
app.editor.first-name=Katarzyna
app.editor.last-name=Daliga

spring.datasource.url=jdbc:mariadb://127.0.0.1:3306/budget_pzs
spring.datasource.username=budget_pzs
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

app.backup.enabled=true
app.backup.directory=/var/www/pzs.budzetowanie.org/backups
app.backup.retention-count=14
app.backup.cron=0 0 3 * * *
